<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoundTrackPlayer.View.PlayListContentView"
             xmlns:vm="clr-namespace:SoundTrackPlayer.ViewModel"
             xmlns:model="clr-namespace:SoundTrackPlayer.Model">
    <ContentView.Resources>
        <model:LoopModeToStringConverter x:Key="loop_mode_to_string_converter" />
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Text="{Binding Path=Name, StringFormat='プレイリスト: {0}'}" Grid.Row="0" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" Margin="10"/>
            <HorizontalStackLayout Grid.Row="1">
                <!--<Label Text="複数選択" VerticalOptions="Center" Margin="5" />
                <Switch IsToggled="{Binding Path=IsMultipleSelectionEnabled}" VerticalOptions="Center" MinimumWidthRequest="0" Margin="5" />
                <Button Text="登録" Command="{Binding Path=AddCommand}" VerticalOptions="Center" Margin="5" />
                <Button Text="解除" Command="{Binding Path=DeleteCommand}" VerticalOptions="Center" Margin="5" />
                <Button Text="クリア" Command="{Binding Path=ClearCommand}" VerticalOptions="Center" Margin="5" />-->
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" Color="Gray" Grid.Row="2" />
        </Grid>
        <Grid Padding="5" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Label Text="" Grid.Column="0" VerticalOptions="Center" Margin="5"/>
            <Label Text="タイトル" LineBreakMode="TailTruncation" Grid.Column="1" VerticalOptions="Center" Margin="5,0,5,0"/>
            <Label Text="ループモード" Grid.Column="2" VerticalOptions="Center" Margin="5,0,5,0"/>
            <Label Text="ループ開始位置" Grid.Column="3" VerticalOptions="Center" Margin="5,0,5,0"/>
            <Label Text="ループ終了位置" Grid.Column="4" VerticalOptions="Center" Margin="5,0,5,0"/>
            <Label Text="ループ区間再生回数" Grid.Column="5" VerticalOptions="Center" Margin="5,0,5,0"/>
        </Grid>
        <CollectionView SelectionMode="Single" ItemsSource="{Binding Path=Tracks}" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <ImageButton Source="{AppThemeBinding Light=play_light.png, Dark=play_dark.png}" Command="{Binding Path=PlayButtonCommand}" Grid.Column="0" WidthRequest="30" HeightRequest="30" MinimumHeightRequest="0" MinimumWidthRequest="0"/>
                        <Label Text="{Binding Path=Track.Info.Title}" LineBreakMode="TailTruncation" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="1" VerticalOptions="Center" Margin="5"/>
                        <Label Text="{Binding Path=Track.Config.DefaultLoopMode, Converter={StaticResource loop_mode_to_string_converter}}" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="2" VerticalOptions="Center" Margin="5"/>
                        <Label Text="{Binding Path=Track.Config.LoopBegin, StringFormat='{0:hh}:{0:mm}:{0:ss}.{0:ffffff}', TargetNullValue='未設定'}" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="3" VerticalOptions="Center" Margin="5"/>
                        <Label Text="{Binding Path=Track.Config.LoopEnd, StringFormat='{0:hh}:{0:mm}:{0:ss}.{0:ffffff}', TargetNullValue='未設定'}" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="4" VerticalOptions="Center" Margin="5"/>
                        <Label Text="{Binding Path=Track.Config.LoopCount, TargetNullValue='未設定'}" HorizontalOptions="End" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="5" VerticalOptions="Center" Margin="5"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
