<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoundTrackPlayer.View.PlayQueueContentView"
             xmlns:vm="clr-namespace:SoundTrackPlayer.ViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentView.Resources>
        <vm:PlayQueueViewModel x:Key="PlayQueueViewModel" />
    </ContentView.Resources>
    <ContentView.BindingContext>
        <StaticResource Key="PlayQueueViewModel"></StaticResource>
    </ContentView.BindingContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Text="再生キュー" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" Margin="10"/>
            <HorizontalStackLayout Grid.Row="1">
                <Label Text="複数選択" VerticalOptions="Center" Margin="5" />
                <Switch IsToggled="{Binding Path=IsMultipleSelectionEnabled}" VerticalOptions="Center" MinimumWidthRequest="0" Margin="5" />
                <Button Text="登録" Command="{Binding Path=AddCommand}" VerticalOptions="Center" Margin="5" />
                <Button Text="解除" Command="{Binding Path=DeleteCommand}" VerticalOptions="Center" Margin="5" />
                <Button Text="クリア" Command="{Binding Path=ClearCommand}" VerticalOptions="Center" Margin="5" />
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" Color="Gray" Grid.Row="2" />
        </Grid>
        <CollectionView SelectionChangedCommand="{Binding Path=SelectedTracksChangedCommand}" SelectedItem="{Binding Path=SelectedTrack}" SelectedItems="{Binding Path=SelectedTracks, Mode=TwoWay}" SelectionMode="{Binding Path=SelectionMode}" ItemsSource="{Binding Path=Tracks}" CanReorderItems="{Binding Path=ItemReorderEnabled}" Grid.Row="1" Margin="0,5,0,0">
            <CollectionView.Behaviors>
                <toolkit:EventToCommandBehavior 
                    EventName="ReorderCompleted" 
                    Command="{Binding Path=ReorderCompletedCommand}" 
                    BindingContext="{StaticResource PlayQueueViewModel}">
                </toolkit:EventToCommandBehavior>
            </CollectionView.Behaviors>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ImageButton Source="{AppThemeBinding Light=play_light.png, Dark=play_dark.png}" Command="{Binding Path=PlayButtonCommand}" Grid.Column="0" WidthRequest="30" HeightRequest="30" MinimumHeightRequest="0" MinimumWidthRequest="0"/>
                        <Label Text="{Binding Path=Track.Info.Title}" FontAttributes="{Binding Path=FontAttributes}" Grid.Column="1" VerticalOptions="Center" Margin="5"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
